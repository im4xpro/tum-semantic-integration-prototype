# URL of the running backend API (without /api suffix)
VITE_API_URL=http://localhost:8420

# Default values pre-filled when creating a new mapping (leave blank to start empty)
VITE_DEFAULT_BASE_URI=https://example.org/instances/
VITE_DEFAULT_NAMESPACE_PREFIX=ex
VITE_DEFAULT_NAMESPACE_URI=https://example.org/ontology#

VITE_LLM_PROVIDER=openrouter
VITE_LLM_MODEL=anthropic/claude-sonnet-5
